# Copie para .env.local (nunca commite segredos)

# Gemini (build injeta em process.env.API_KEY via vite.config)
GEMINI_API_KEY=
# Opcional: modelo para gerar o plano (padrão gemini-2.5-flash; Pro exige faturamento/cota)
# GEMINI_DIET_MODEL=gemini-2.5-flash

# Supabase — app web / Capacitor
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# Fallback se RLS/coupons falhar (lista separada por vírgula)
VITE_INVITE_CODES=
